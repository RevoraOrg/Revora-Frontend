{
  "consumer": {
    "name": "revora-frontend"
  },
  "interactions": [
    {
      "description": "a request for notifications",
      "providerStates": [
        {
          "name": "notifications are available"
        }
      ],
      "request": {
        "headers": {
          "authorization": "Bearer test-token"
        },
        "method": "GET",
        "path": "/notifications"
      },
      "response": {
        "body": [
          {
            "createdAt": "2026-07-30T10:00:00.000Z",
            "id": "notif-001",
            "message": "Your latest revenue share payout is available.",
            "read": false,
            "title": "Payout ready"
          }
        ],
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].read": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "notifications-service"
  }
}